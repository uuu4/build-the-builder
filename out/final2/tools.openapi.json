  "/cards.list": {
   "post": {
    "operationId": "cards.list",
    "summary": "The customer's eligible cards. 404 FB_IVR_CHANNEL_102 = no valid card.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "data"
        ],
        "properties": {
         "data": {
          "type": "object",
          "required": [
           "customerNo"
          ],
          "properties": {
           "customerNo": {
            "type": "string"
           },
           "aiFlow": {
            "type": "string",
            "default": "CardOps"
           }
          }
         },
         "call": {
          "type": "object",
          "properties": {
           "ani": {
            "type": "string"
           },
           "lang": {
            "type": "string",
            "default": "tr"
           }
          }
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Success (result.returnCode '1')",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "data": {
           "type": "object",
           "properties": {
            "cards": {
             "type": "array",
             "items": {
              "type": "object",
              "properties": {
               "cardNumber": {
                "type": "string"
               },
               "cardNumberLast4": {
                "type": "string"
               },
               "productName": {
                "type": "string"
               },
               "status": {
                "type": "string",
                "enum": [
                 "A"
                ]
               },
               "isMainCard": {
                "type": "boolean"
               }
              }
             }
            },
            "validCardsCount": {
             "type": "integer"
            },
            "exitState": {
             "type": "string",
             "enum": [
              "1_CARD",
              "MULTI_CARD"
             ]
            }
           }
          },
          "result": {
           "type": "object",
           "properties": {
            "guid": {
             "type": "string"
            },
            "returnCode": {
             "type": "string",
             "description": "'1' = success; otherwise an error code (INVALID_ARGUMENTS_ERROR, FB_IVR_CHANNEL_102, FB_IVR_CHANNEL_120, FB_IVR_CHANNEL_121, FB_IVR_CHANNEL_107, FBE00099)"
            },
            "messageText": {
             "type": "string"
            },
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "type": {
             "type": "string",
             "enum": [
              "ERROR",
              "WARNING"
             ],
             "nullable": true
            },
            "details": {
             "type": "object",
             "properties": {
              "guid": {
               "type": "string"
              },
              "rootCause": {
               "type": "string"
              },
              "errorOrigin": {
               "type": "string"
              }
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "INVALID_ARGUMENTS_ERROR"
     },
     "404": {
      "description": "WARNING not found code"
     },
     "500": {
      "description": "FBE00099 technical error"
     }
    }
   }
  },
