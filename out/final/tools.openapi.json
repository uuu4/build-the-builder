           }
          },
          "result": {
           "type": "object",
           "properties": {
            "guid": {
             "type": "string"
            },
            "returnCode": {
             "type": "string"
            },
            "messageText": {
             "type": "string"
            },
            "code": {
             "type": "string"
            },
            "message": {
             "type": "string"
            },
            "type": {
             "type": "string",
             "enum": [
              "ERROR",
              "WARNING"
